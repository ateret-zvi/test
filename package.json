{
  "name": "elbitbox",
  "version": "1.0.0",
  "description": "A shared network jukebox (bitbox) server. Clients add YouTube songs to a shared playlist and everyone listens to the same synchronized stream.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "keywords": [
    "jukebox",
    "bitbox",
    "youtube",
    "music",
    "stream"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "stream-throttle": "^0.1.3",
    "ws": "^8.18.0",
    "youtube-dl-exec": "^3.0.10"
  }
}
